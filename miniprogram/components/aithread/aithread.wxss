.aithread{margin-top:10px;display:flex;flex-direction:column;gap:8px}
.aimsg{white-space:pre-wrap;border:1px solid var(--brass-deep);border-radius:12px;padding:9px 11px;background:rgba(214,166,74,.06);font-size:14px;line-height:1.65}
.aimsg.me{align-self:flex-end;max-width:88%;border-color:var(--felt-line);background:#0a2219}
.aimsg.err{border-color:var(--bad);color:var(--bad)}
.aimsg.wait{color:var(--muted)}
.aiask{display:flex;gap:6px;align-items:center}
.aiask .input{flex:1}
.aisug{display:flex;gap:6px;flex-wrap:wrap}
.sugb{border:1px solid var(--felt-line);color:var(--muted);border-radius:999px;padding:2px 10px;font-size:12.5px}
